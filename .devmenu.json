  "menus": {
    "main": {
      "title": "MAIN_TITLE",
      "items": [
        {"label": "INSTALL", "desc": "INSTALL_DESC", "key": "i", "icon": "📦", "command": "uv sync --locked"},
        {"label": "START", "desc": "START_DESC", "key": "s", "icon": "▶", "command": "uv run yt-transcript start"},
        {"label": "STOP", "desc": "STOP_DESC", "key": "x", "icon": "■", "command": "uv run yt-transcript stop"},
        {"label": "RESTART", "desc": "RESTART_DESC", "key": "r", "icon": "↻", "command": "uv run yt-transcript restart"},
        {"label": "STATUS", "desc": "STATUS_DESC", "key": "e", "icon": "ℹ", "command": "uv run yt-transcript status"},
        {"label": "LOGS", "desc": "LOGS_DESC", "key": "l", "icon": "📄", "command": "uv run yt-transcript logs"},
        {"label": "FOLLOW", "desc": "FOLLOW_DESC", "key": "j", "icon": "📜", "command": "uv run yt-transcript logs --follow"},
        {"label": "DEV", "desc": "DEV_DESC", "key": "d", "icon": "🛠", "command": "uv run yt-transcript dev"},
        {"label": "CHECK", "desc": "CHECK_DESC", "key": "c", "icon": "✓", "command": "uv run python scripts/check.py"},
        {"label": "TEST", "desc": "TEST_DESC", "key": "t", "icon": "🧪", "command": "uv run pytest --cov --cov-report=html --cov-report=term"},
        {"label": "LINT", "desc": "LINT_DESC", "key": "u", "icon": "🔎", "command": "uv run ruff check ."},
        {"label": "FORMAT", "desc": "FORMAT_DESC", "key": "f", "icon": "✨", "command": "uv run ruff format ."},
        {"label": "TYPES", "desc": "TYPES_DESC", "key": "m", "icon": "🔤", "command": "uv run mypy"},
        {"label": "BUILD", "desc": "BUILD_DESC", "key": "b", "icon": "🔨", "command": "uv build"},
        {"label": "WHEEL", "desc": "WHEEL_DESC", "key": "w", "icon": "📦", "command": "uv run python scripts/smoke_wheel.py"},
        {"label": "INFO", "desc": "INFO_DESC", "key": "p", "icon": "ℹ", "command": "uv run yt-transcript info"},
        {"label": "QUIT_ITEM", "key": "q", "icon": "🚪", "action": "exit"}
      ]
    }
  }
}

      "STOP": "Arrêter", "STOP_DESC": "Arrête uniquement le serveur géré par ce projet",
      "RESTART": "Redémarrer", "RESTART_DESC": "Arrête puis relance le serveur",
      "STATUS": "Statut", "STATUS_DESC": "Vérifie l'identité du processus ; code 1 si arrêté",
      "LOGS": "Logs", "LOGS_DESC": "Affiche les 50 dernières lignes",
      "FOLLOW": "Suivre les logs", "FOLLOW_DESC": "Suivi continu ; Ctrl+C pour revenir",
      "DEV": "Mode développement", "DEV_DESC": "Serveur interactif avec debug et rechargement",
      "CHECK": "Tous les contrôles", "CHECK_DESC": "Ruff, format, mypy et tests avec couverture",
      "TEST": "Tests et couverture", "TEST_DESC": "TU et intégration sans appels YouTube",
      "LINT": "Ruff", "LINT_DESC": "Analyse statique sans modification",
      "FORMAT": "Formater", "FORMAT_DESC": "Applique Ruff format aux fichiers Python",
      "TYPES": "Mypy", "TYPES_DESC": "Contrôle tous les modules applicatifs",
      "BUILD": "Construire wheel / sdist", "BUILD_DESC": "Produit les distributions dans dist/",
      "WHEEL": "Vérifier le wheel", "WHEEL_DESC": "Installation isolée puis démarrage HTTP ; build requis",
